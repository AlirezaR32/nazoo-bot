{
  "functions": {
    "api/webhook.py": {
      "runtime": "python3.9",
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/webhook.py"
    }
  ],
  "installCommand": "pip install -r requirements-vercel.txt",
  "buildCommand": "echo 'Build completed'"
}