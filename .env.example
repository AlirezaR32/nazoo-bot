# ─────────────────────────────────────────────────────────────
#  .env — این فایل رو کپی کن به .env و مقادیر رو پر کن
#  در Vercel، این متغیرها رو در Project Settings → Environment Variables بریز
# ─────────────────────────────────────────────────────────────

# ── تلگرام ────────────────────────────────────────────────────
# از @BotFather بگیر
TELEGRAM_TOKEN=your_telegram_bot_token_here

# یوزرنیم ربات بدون @ — اختیاری (اگه ندی، خودش یه‌بار getMe می‌زنه)
BOT_USERNAME=your_bot_username

# یه رشته‌ی تصادفی برای امن کردن webhook — اختیاری ولی شدیداً توصیه میشه
# (همینو موقع ست‌کردن وب‌هوک هم به تلگرام میدی — پایین‌تر توضیح داده شده)
TELEGRAM_WEBHOOK_SECRET=choose_a_random_secret_string


# ── OpenModel.ai (DeepSeek V4 Flash) ────────────────────────────
# https://www.openmodel.ai/model-pricing/deepseek-v4-flash
OPENMODEL_API_KEY=your_openmodel_api_key
OPENMODEL_BASE_URL=https://api.openmodel.ai/v1
AI_MODEL=deepseek-v4-flash


# ── هویت ربات ───────────────────────────────────────────────
BOT_NAME=Nazoo
PERSONALITY_FILE=personality.txt


# ── حافظه محلی — فقط حالت polling (bot.py روی لپ‌تاپ/VPS) ──
DB_PATH=nazoo_memory.db
MAX_HISTORY=30
MAX_FACTS=25


# ── حافظه ابری — فقط حالت Vercel (api/webhook.py) ───────────
# چون فایل‌سیستم Vercel موقتیه، اینجا به یه دیتابیس Redis نیاز داری.
# گزینه‌ها:
#   ۱) از Vercel Marketplace یه Upstash/KV integration وصل کن (خودش env رو ست می‌کنه)
#   ۲) مستقیم یه دیتابیس رایگان در upstash.com بساز
# هرکدوم از این دو جفت متغیر رو پر کنی کافیه:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# یا:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── تنظیمات مدل ──────────────────────────────────────────────
MAX_TOKENS=1024
TEMPERATURE=0.9
